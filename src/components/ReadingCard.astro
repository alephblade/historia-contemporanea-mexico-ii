---
import type { Reading } from '../lib/public-data';
import { withBase } from '../lib/paths';
import StatusBadge from './StatusBadge.astro';

interface Props {
  reading: Reading;
  showSummary?: boolean;
}

const { reading, showSummary = true } = Astro.props;
const principal = reading.unidades.find((unit) => unit.rol === 'principal');
---

<article
  class="reading-card"
  data-filter-item
  data-unit={reading.unidades.map((unit) => unit.id).join(' ')}
  data-level={reading.niveles.join(' ')}
  data-type={reading.tipo_material.codigo ?? reading.tipo_material.etiqueta}
  data-status={reading.estado_editorial}
  data-search={`${reading.titulo} ${reading.autoria} ${reading.temas.join(' ')}`.toLocaleLowerCase('es-MX')}
>
  <div class="card-kicker">
    <span class="canonical-id">{reading.id}</span>
    <StatusBadge status={reading.estado_editorial} />
  </div>
  <h2><a href={withBase(`/lecturas/${reading.slug}/`)}>{reading.titulo}</a></h2>
  <p class="card-meta">{reading.tipo_material.etiqueta} · {reading.niveles.join(' · ')}</p>
  {showSummary && <p>{reading.resumen}</p>}
  {principal && (
    <p class="card-unit">
      <span>Unidad principal</span>
      <a href={withBase(`/unidades/${principal.slug}/`)}>{principal.nombre}</a>
    </p>
  )}
  <a class="text-link" href={withBase(`/lecturas/${reading.slug}/`)}>Consultar lectura y ficha <span aria-hidden="true">→</span></a>
</article>
